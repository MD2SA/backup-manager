# Server Configuration
APP_PORT=8080
APP_LOG_LEVEL=info
APP_TEMP_DIR=/tmp
# Mandatory: Path on the host machine where backups will be stored.
# Development: ./backups
# Production:  /var/lib/backup-manager/storage
APP_BACKUP_PATH=./backups

# User/Group IDs for Docker (run 'id -u' and 'id -g' to find yours)
# This ensures backups on the host are owned by you.
PUID=1000
PGID=1000

# Optional: Age Encryption (X25519)
# Generate with: age-keygen -o key.txt
# APP_AGE_PUBLIC_KEY=
# APP_AGE_PRIVATE_KEY=

# Metadata Database (Internal state - profiles, logs, settings)
APP_METADATA_DB_HOST=localhost
APP_METADATA_DB_PORT=5432
APP_METADATA_DB_USER=postgres
APP_METADATA_DB_PASSWORD=postgres
APP_METADATA_DB_DBNAME=backup_manager
APP_METADATA_DB_SSLMODE=disable

# Target Database (The database that will be backed up)
APP_TARGET_DB_HOST=localhost
APP_TARGET_DB_PORT=5432
APP_TARGET_DB_USER=postgres
APP_TARGET_DB_PASSWORD=postgres
APP_TARGET_DB_DBNAME=my_project_db
APP_TARGET_DB_SSLMODE=disable
