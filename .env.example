# Server Configuration
APP_PORT=8080
APP_LOG_LEVEL=info
APP_ENV=development
APP_TEMP_DIR=/tmp
# Mandatory: Static API Key for authentication.
# Required when APP_ENV=production; optional in development (insecure mode).
APP_ADMIN_KEY=change-me-in-production

# Rate Limiting (Default: 100 requests per 1 minute)
# APP_RATE_LIMIT_REQUESTS=100
# APP_RATE_LIMIT_WINDOW=1m

# CORS (comma-separated list of allowed origins; default: http://localhost:3000)
# APP_CORS_ORIGINS=http://localhost:3000

# Trusted Proxies (comma-separated IPs or CIDRs for X-Forwarded-For resolution)
# Use when behind a reverse proxy (nginx, Caddy, Traefik, Cloudflare, etc.)
# APP_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# Provider config encryption at rest (AES-256-GCM).
# Leave empty for plaintext storage (dev mode).
# Set a passphrase in production; changing it invalidates existing provider configs.
# APP_CONFIG_ENCRYPT_KEY=change-me

# Mandatory: Path on the host machine where backups will be stored.
# Development: ./backups
# Production:  /var/lib/backup-manager/storage
APP_BACKUP_PATH=./backups

# User/Group IDs for Docker (run 'id -u' and 'id -g' to find yours)
# This ensures backups on the host are owned by you.
PUID=1000
PGID=1000

# Optional: Age Encryption (X25519)
# Option A: Simple Passphrase
# APP_ENCRYPTION_PASSPHRASE=minha-password-secreta

# Option B: Pro Keypair (Generate with: age-keygen -o key.txt or use built-in 'keygen')
# APP_AGE_PUBLIC_KEY=
# APP_AGE_PRIVATE_KEY=

# Metadata Database (Internal state - profiles, logs, settings)
# Host publish port for Docker; also used by local `go run`/`make migrate`.
# Inside Docker the app talks to metadata-db:5432 (see docker-compose(.dev).yml).
APP_METADATA_DB_HOST=localhost
APP_METADATA_DB_PORT=5432
APP_METADATA_DB_USER=postgres
APP_METADATA_DB_PASSWORD=postgres
APP_METADATA_DB_DBNAME=backup_manager
APP_METADATA_DB_SSLMODE=disable

# Target Database (Optional at startup, mandatory for backup/restore execution)
# Can be any host (local, container name, or remote IP).
# APP_TARGET_DB_PORT is the HOST-facing publish port only (5433); the PostgreSQL
# container listens on 5432 internally. Never used inside the Docker app.
APP_TARGET_DB_HOST=
APP_TARGET_DB_PORT=5433
APP_TARGET_DB_USER=
APP_TARGET_DB_PASSWORD=
APP_TARGET_DB_DBNAME=
APP_TARGET_DB_SSLMODE=disable

# Metadata Self-Backup (requires pg_dump in PATH)
# - Local cron copy (disabled by default; schedule as cron expression, e.g. "0 3 * * *")
#   APP_METADATA_BACKUP_SCHEDULE=
#   APP_METADATA_BACKUP_PASSPHRASE=
#   APP_METADATA_BACKUP_RETENTION=14
# - Embed into every backup execution (ENABLED by default; default: true).
#   Each backup uploads an encrypted metadata snapshot to every storage provider
#   of the profile under meta/<profile-id>/metadata-<timestamp>.dump.age.
#   The dump is encrypted with the profile's backup keys, falling back to
#   APP_METADATA_BACKUP_PASSPHRASE; without either it is skipped (never plaintext).
#   APP_METADATA_BACKUP_EMBED=true
