# Docker Compose settings only.
#
# The application itself does NOT read this file. It reads config.yaml and
# secrets.env. Generate both with:
#   go run ./cmd/api init
#   # or, in Docker: docker run --rm -v "$PWD:/work" -w /work backup-manager init
#
# Keep this file for the bundled metadata database and host-level settings.

APP_PORT=8080
APP_BACKUP_PATH=./backups
CONFIG_PATH=./config.yaml
SECRETS_PATH=./secrets.env
IMAGE_TAG=backup-manager:latest

# User/Group IDs for Docker (run 'id -u' and 'id -g' to find yours)
PUID=1000
PGID=1000

# Bundled metadata database (docker-compose.yml).
# These values must match `metadata_database` in config.yaml and the
# METADATA_DB_PASSWORD entry in secrets.env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=backup_manager

# Development stack only (docker-compose.dev.yml)
TARGET_DB_NAME=project_db
TARGET_DB_HOST_PORT=5433
