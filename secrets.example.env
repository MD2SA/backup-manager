# Backup Manager secrets — EXAMPLE ONLY.
#
# Copy this file to secrets.env, replace every value, and run:
#   chmod 600 secrets.env
#
# Never commit secrets.env. Values may contain spaces or '#'; quote them with
# double quotes if needed. Empty optional values are allowed.

METADATA_DB_PASSWORD=replace-me
TARGET_DB_PASSWORD=replace-me
# Optional: separate password for the restore role.
TARGET_DB_RESTORE_PASSWORD=

# Age X25519 private key (generate with: backup-manager keygen).
AGE_PRIVATE_KEY=

# Passphrase used when a profile enables passphrase encryption.
ENCRYPTION_PASSPHRASE=replace-me

# Bootstrap admin API key. Generate with: openssl rand -base64 32
ADMIN_KEY=replace-me

# AES-256-GCM key for provider credentials at rest.
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPT_KEY=replace-me

# Passphrase for embedded/local metadata snapshots.
METADATA_BACKUP_PASSPHRASE=
